# {{ ansible_managed }}
# /etc/rancher/k3s/config.yaml — Ansible owns this file. Do not hand-edit.
#
# Some options must be IDENTICAL on every server or a new member fails to join
# an embedded-etcd cluster. Keeping them in one template is the reason this is
# a role and not a set of pasted flags.
token: "{{ vault_k3s_token }}"
node-ip: "{{ ansible_host }}"
node-name: "{{ inventory_hostname }}"

{% if k3s_kubelet_labels | default({}) %}
# K3s applies node-label at REGISTRATION ONLY (F8). Changing these on an
# already-joined node needs `kubectl label`; the file is still the record of
# what a rebuild of this node should come up with.
#
# Only labels kubelet will accept appear here. Anything in the kubernetes.io
# or k8s.io namespace outside the permitted set — node-role.kubernetes.io/*
# above all — makes kubelet exit with 'failed to validate kubelet flags',
# which takes k3s down with it on every start.
node-label:
{% for key, value in k3s_kubelet_labels | dictsort %}
  - "{{ key }}={{ value }}"
{% endfor %}

{% endif %}
{% if k3s_role == 'server' %}
{% if k3s_cluster_init | default(false) %}
# deus only. Restarting the server with this flag converts the existing
# embedded SQLite datastore to etcd. The conversion is ONE-WAY.
cluster-init: true
{% else %}
# k3s_api_endpoint is the cluster-init server until k3s_bootstrap_complete is
# flipped, then the VIP. After the flip no server depends on deus any more.
server: "https://{{ k3s_api_endpoint | trim }}:6443"
{% endif %}

# The VIP MUST be here or the API answers on it with
# 'x509: certificate is valid for ...' (F4).
tls-san:
{% for san in k3s_tls_sans %}
  - "{{ san }}"
{% endfor %}

write-kubeconfig-mode: "0644"

etcd-snapshot-schedule-cron: "{{ etcd_snapshot_cron }}"
etcd-snapshot-retention: {{ etcd_snapshot_retention }}

kubelet-arg:
  - "system-reserved={{ kubelet_reserved.system_reserved }}"
  - "kube-reserved={{ kubelet_reserved.kube_reserved }}"
{% else %}
# Agents follow the same endpoint. Flipping k3s_bootstrap_complete and
# re-running is what moves them from deus to the VIP — that IS Phase 5, and
# it means a run before Phase 3 leaves them pointed where the cluster is.
server: "https://{{ k3s_api_endpoint | trim }}:6443"
{% endif %}
