# {{ ansible_managed }}
# /etc/rancher/k3s/config.yaml.d/etcd-s3.yaml — mode 0600, holds credentials.
#
# These live in a config file rather than etcd-s3-config-secret deliberately:
# during a restore the cluster is not running, so Secrets cannot be read. S3
# config has to come from the config file or CLI flags or disaster recovery is
# not possible.
etcd-s3: true
etcd-s3-endpoint: "{{ etcd_s3_endpoint }}"
etcd-s3-bucket: "{{ etcd_s3_bucket }}"
etcd-s3-region: "{{ etcd_s3_region }}"
etcd-s3-access-key: "{{ vault_etcd_s3_access_key }}"
etcd-s3-secret-key: "{{ vault_etcd_s3_secret_key }}"
{% if etcd_s3_insecure | default(false) %}
# Disables S3 over HTTPS. Required for a plain-HTTP endpoint.
etcd-s3-insecure: true
{% endif %}
{% if etcd_s3_skip_ssl_verify | default(false) %}
# Disables certificate validation only — still HTTPS.
etcd-s3-skip-ssl-verify: true
{% endif %}
