# {{ ansible_managed }}
# Static pod: k3s's kubelet runs anything in this directory without asking the
# API server, which is what lets kube-vip front the API server it would
# otherwise depend on.
#
# kube-vip's own K3s page recommends a DaemonSet in
# /var/lib/rancher/k3s/server/manifests/. That path is vendor-supported, but it
# has Ansible writing cluster resources (ServiceAccount, ClusterRole,
# DaemonSet) onto disk — the exact layer-boundary violation this repo exists to
# avoid — and it makes the VIP depend on the API server it fronts.
#
# Two known sharp edges, both worth testing in the VM lab before Phase 3:
#   - kube-vip#830: a static pod has no ServiceAccount token, so it must
#     authenticate from a kubeconfig. Hence the admin.conf mount below.
#   - kube-vip#909: a static-pod kube-vip was reported not restarting after a
#     node reboot on RKE2. Test reboot survival explicitly (F14). If it
#     reproduces, fall back to the DaemonSet path — a working VIP beats a tidy
#     diagram.
apiVersion: v1
kind: Pod
metadata:
  name: kube-vip
  namespace: kube-system
  # Without these the pod is unfindable by selector — `kubectl get pods -l
  # component=kube-vip` returns nothing whether or not it is running, which
  # makes "is the VIP up?" impossible to answer from the API.
  labels:
    component: kube-vip
    tier: control-plane
    app.kubernetes.io/name: kube-vip
spec:
  hostNetwork: true
  containers:
    - name: kube-vip
      image: ghcr.io/kube-vip/kube-vip:{{ kube_vip_version }}
      imagePullPolicy: IfNotPresent
      args: ["manager"]
      env:
        - { name: vip_arp,            value: "true" }
        - { name: port,               value: "6443" }
        - { name: vip_interface,      value: "{{ kube_vip_interface }}" }
        - { name: vip_cidr,           value: "32" }
        - { name: cp_enable,          value: "true" }
        - { name: cp_namespace,       value: "kube-system" }
        - { name: vip_ddns,           value: "false" }
        # ServiceLB already owns LoadBalancer Services on this cluster,
        # including penny-dev's Postgres on 5432. Enabling kube-vip's service
        # controller would give you two controllers fighting over the same
        # objects.
        - { name: svc_enable,         value: "false" }
        - { name: vip_leaderelection, value: "true" }
        - { name: vip_leaseduration,  value: "15" }
        - { name: vip_renewdeadline,  value: "10" }
        - { name: vip_retryperiod,    value: "2" }
        - { name: address,            value: "{{ k3s_vip }}" }
        - { name: prometheus_server,  value: ":2112" }
      securityContext:
        capabilities:
          add: ["NET_ADMIN", "NET_RAW", "SYS_TIME"]
      volumeMounts:
        - name: kubeconfig
          mountPath: /etc/kubernetes/admin.conf
          readOnly: true
  volumes:
    - name: kubeconfig
      hostPath:
        path: /etc/rancher/k3s/k3s.yaml
        type: File
